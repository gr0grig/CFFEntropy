#include <windows.h>
#include <commctrl.h>
#include "resource.h"
IDD_ENTROPY DIALOGEX 0, 0, 470, 260
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Shannon entropy (0-8 bits/byte)", IDC_HEADING, 8, 8, 230, 12
    LTEXT "Blocks:", IDC_BLOCKS_LABEL, 240, 8, 32, 12
    COMBOBOX IDC_BLOCKS, 275, 5, 68, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Full", IDC_FULL, 350, 5, 48, 16
    PUSHBUTTON "Refresh", IDC_REFRESH, 405, 5, 57, 16
    CONTROL "", IDC_TABLE, "SysListView32", WS_CHILD | WS_VISIBLE | WS_TABSTOP | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 8, 28, 454, 194
    CONTROL "", IDC_CHART, "Static", WS_CHILD | WS_VISIBLE | SS_OWNERDRAW | SS_NOTIFY, 8, 120, 454, 100
    LTEXT "File offset: -", IDC_OFFSET, 8, 222, 454, 12
    LTEXT "", IDC_STATUS, 8, 229, 454, 26
END
